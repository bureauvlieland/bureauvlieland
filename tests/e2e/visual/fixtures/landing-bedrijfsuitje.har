50,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/rondleiding-brouwerij-fortuna.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":100,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-03T07:35:15.761661+00:00\",\"updated_at\":\"2026-09-22T04:30:04.232477+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2990258,\"location_lng\":5.0929034,\"location_address\":\"Fortuna Vlieland, 10, Fortweg\",\"map_activity_type_id\":278,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"wellness-vlieland-experience\",\"slug\":\"vlieland-experience-wellness\",\"name\":\"Vlieland Experience (Wellness)\",\"description\":\"De ultieme Vlieland Experience bij Wellcome Wellness — 120 minuten compleet uitgebreide behandeling. Anti-stress, voedend en herstellend: lichaamspeeling, lichaamspakking, Recover Touch facial en een ontspannende massage. Ideaal voor kleine groepen.\",\"short_description\":\"120 min uitgebreide wellness-behandeling: peeling, pakking, facial & massage.\",\"category\":\"overig\",\"block_type\":\"partner\",\"provider_id\":\"island-events\",\"min_people\":1,\"max_people\":8,\"duration\":\"120 min\",\"price_adult\":180.00,\"price_adult_note\":null,\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":null,\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":null,\"is_from_price\":false,\"price_display_override\":null,\"price_extras\":{},\"external_url\":\"https://vlieland.wellcomewellness.nl\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/wellness-vlieland-experience.jpg\",\"image_asset\":null,\"is_published\":true,\"is_active\":true,\"sort_order\":101,\"tags\":null,\"seasonal_notes\":null,\"created_at\":\"2026-04-21T14:11:32.808471+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.3034104,\"location_lng\":5.0513243,\"location_address\":\"Badweg 3, 8899 BV Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"vliehors-expres-exclusief\",\"slug\":\"vliehors-expres-exclusief\",\"name\":\"Vliehors Expres Exclusief\",\"description\":\"De Vliehors Expres maakt een tocht met u over de Vliehors, een zandvlakte van 20 vierkante kilometer aan de westkant van Vlieland. De tocht duurt 2 uren. \\n\\nTijdens deze 2 uur durende rondritten laten wij u graag kennis maken met de weidsheid van de Vliehors. Natuurlijk stoppen we onderweg ook bij het drenkelingenhuisje. Al meer dan honderd jaar een vluchthuisje voor gestrande schipbreukelingen, nu ingericht als juttersmuseum.\\n\\nTijdens de rondrit stappen we ook uit op het meest westelijke puntje van Vlieland. We zijn dan vlak bij het buureiland Texel. Rond de punt van de Vliehors zwemmen vaak zeehonden. De kans is groot dat we deze dieren te zien krijgen. Een unieke ervaring in een fantastisch on Nederlands landschap.\",\"short_description\":\"Vliehors Expres, avontuurlijk Vlieland!\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"vliehors-expres\",\"min_people\":null,\"max_people\":null,\"duration\":\"2 uur\",\"price_adult\":825.00,\"price_adult_note\":\"\",\"price_type\":\"tiered_total\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":nul