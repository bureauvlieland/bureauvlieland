\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770974443694-terras.2_1.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-13T09:20:59.543228+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"zeehondentocht\",\"slug\":\"zeehondentocht\",\"name\":\"Zeehondentocht\",\"description\":\"Uw bezoek aan Vlieland is niet compleet zonder een zeehondentocht met de Geus, de Northern Diver of de Vlielander. Met deze supersnelle rubberboten (40 mijl p/u) kunt u kennis maken met de natuur rondom Vlieland. Een ware belevenis voor jong en oud!\\r\\n\\r\\nDe schipper zal proberen om zo dicht mogelijk bij de robben te komen. U kunt de zeehonden zien genieten terwijl ze lekker liggen te zonnen op zandplaat De Richel of Engelschhoek bij Terschelling. Zeehonden zijn van nature nieuwsgierig en zwemmen vaak dicht bij de boot.\",\"short_description\":\"Spot zeehonden in hun natuurlijke habitat\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"zeehonden\",\"min_people\":10,\"max_people\":40,\"duration\":\"45 uur\",\"price_adult\":32.50,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/