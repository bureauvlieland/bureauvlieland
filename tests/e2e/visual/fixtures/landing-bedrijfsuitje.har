            "size": -1,
            "mimeType": "application/json; charset=utf-8",
            "text": "[{\"id\":\"strandyoga-ontspanning\",\"slug\":\"strandyoga-ontspanning\",\"name\":\"Strandyoga & ontspanning\",\"description\":\"Een begeleide sessie op het strand met lichte oefeningen en ademhaling. Ontspannen bewegen met uitzicht op zee.\",\"short_description\":\"Een begeleide yogasessie op het strand\",\"category\":\"outdoor\",\"block_type\":\"partner\",\"provider_id\":\"vlieland-yoga\",\"min_people\":5,\"max_people\":150,\"duration\":\"60 minuten\",\"price_adult\":15.00,\"price_adult_note\":\"Staffel Bedrijfsyoga\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":null,\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":null,\"is_from_price\":true,\"price_display_override\":\"Vanaf €15 p.p o.b.v staffel Bedrijfsyoga\",\"price_extras\":{},\"external_url\":\"www.vlieland-yoga.nl\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/strandyoga-ontspanning.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"ontspanning\",\"verbinding\",\"vitaliteit\",\"energie\",\"rust\",\"reset\",\"ademhaling\",\"welzijn\",\"teambuilding\",\"bedrijfsyoga\",\"strandyoga\"],\"seasonal_notes\":null,\"created_at\":\"2026-02-16T22:01:15.565414+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":9,\"status\":\"published\",\"location_lat\":53.303332,\"location_lng\":5.0453,\"location_address\":\"Strand t.h.v. bushalte Ankerplaats, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"midgetgolf\",\"slug\":\"midgetgolf\",\"name\":\"Midgetgolf\",\"description\":\"Gelegen in het dorp is midgetgolfbaan De oude Vuurtoren een ideale plek om tegen elkaar te strijden voor het minst aantal slagen in 18 uitdagende holes. Voor jong en oud een leuke activiteit. \",\"short_description\":\"18 holes midgetgolfbaan\",\"category\":\"activiteiten\",\"block_type\":\"partner\",\"provider_id\":null,\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":8.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/midgetgolf.webp\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-05-15T13:36:45.876558+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.297222,\"location_lng\":5.076842,\"location_address\":\"Dennenlaan 2, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"lunch-aan-boord-bij-rederij-doeksen\",\"slug\":\"lunch-aan-boord-bij-rederij-doeksen\",\"name\":\"Lunch aan boord bij Rederij Doeksen\",\"description\":\"Vuurduin lunch (vanaf 10 personen) Een klassiek 12-uurtje, bestaande uit huisgemaakte tomatensoep, een broodje kaas en een broodje kroket. Geserveerd met een klein glas verse jus d’orange. \",\"short_description\":\"Lunch aan boord het m.s. Vlieland\",\"category\":\"catering\",\"block_type\":\"partner\",\"provider_id\":\"rederij\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":14.95,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/lunch-aan-boord-bij-rederij-doeksen.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-05-14T20:42:53.805528+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":9,\"status\":\"published\",\"location_lat\":53.2961799,\"location_lng\":5.0751214,\"location_address\":\"Veerbootterminal, Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"fietstocht-met-begeleiding\",\"slug\":\"fietstocht-met-begeleiding\",\"name\":\"Fietstocht met begeleiding\",\"description\":\"Wij nemen u mee over het eiland in een twee uur durende fietstocht. De Vlielandse gids vertelt u van alles over het eiland, de natuur, de geschiedenis en de mensen. \",\"short_description\":\"Ontdek het eiland en haar verhalen op de fiets\",\"category\":\"excursies\",\"block_type\":\"bureau\",\"provider_id\":null,\"min_people\":10,\"max_people\":30,\"duration\":\"2 uur\",\"price_adult\":19.00,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/fietstocht-met-begeleiding.jpg\",\"image_asset\":\"fietstocht\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"fietsen\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-01-30T12:06:02.843899+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.296109,\"location_lng\":5.073688,\"location_address\":\"Waddendijk, Bij Willem De Vlamingh, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"wadloopexcursie\",\"slug\":\"wadloopexcursie\",\"name\":\"Wadloopexcursie\",\"description\":\"Ontdek samen met de gids de planten en dieren van deze bijzondere omgeving.\\r\\nWat leeft er in en op het Wad ...\\r\\nDaarbij is ook aandacht voor de bedreigingen voor het Wad, zoals klimaatverandering en zeespiegelstijging.\\r\\n\\r\\n\\r\\nGa met een deskundige gids het Wad op,\\r\\nvoor een leerzame excursie van anderhalf uur.\\r\\n\\r\\nDe Wadexcursie is geschikt en boeiend voor volwassenen en kinderen vanaf 8 jaar.\\r\\n\\r\\nVerzamelen bij Dorpsstraat 150 aan de kant van het kerkplein.\\r\\nHet gebruik van laarzen is inbegrepen in de excursieprijs. Laarzen zijn beschikbaar op de vertreklocatie.\\r\\n\\r\\nDeelname volwassenen 17,50 euro, kinderen tot 12 jaar 12,50 euro.\\r\\nMaximaal aantal deelnemers 15.\\r\\n\\r\\nDe opbrengst van de excursie komt volledig ten goede aan het nieuwe Natuur Educatie Centrum.\",\"short_description\":\"Begeleid wadlopen over de bodem van de Waddenzee\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"stichting-natuur-educatie-cent\",\"min_people\":null,\"max_people\":null,\"duration\":\"100 uur\",\"price_adult\":17.50,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":12.50,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/wadloopexcursie.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-06T23:04:43.325302+00:00\",\"updated_at\":\"2026-09-22T04:30:04.677358+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":121,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"bezoek-het-bunkermuseum\",\"slug\":\"bezoek-het-bunkermuseum\",\"name\":\"Bezoek het bunkermuseum\",\"description\":\"In de ontvangstbunker is een uitgebreide tentoonstelling over het leven en de gebeurtenissen op en rond Vlieland tijdens de Tweede Wereldoorlog en over het hoe en waarom van de fortificaties. Ook wordt een korte film vertoond over de oorlogsjaren op de eilanden en over de Atlantikwall.\\n\\nDaarna volgt een wandeling door de loopgraven en de bunkers, langs de uitzichtpunten en de geschutsopstellingen. In de elf bunkers zijn ook veel documenten, foto’s en voorwerpen tentoongesteld. In het buitenmuseum staan een paar grote objecten uit de oorlogsjaren, waaronder een middelzwaar luchtdoelkanon.\\n\\nBunkermuseum Wn 12H herinnert op een inzichtelijke en tastbare manier aan een periode uit de geschiedenis, die nooit mag worden vergeten.\",\"short_description\":\"Sinds voorjaar 2020 is Bunkermuseum Wn 12H voor bezoekers geopend. \",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"bunkermuseum\",\"min_people\":null,\"max_people\":null,\"duration\":\"1.5\",\"price_adult\":8.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":5.50,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/bezoek-het-bunkermuseum.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"geschiedenis\",\"museum\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-05-14T12:48:04.912581+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2991996,\"location_lng\":5.0399075,\"location_address\":\"Kantonnierspad 1, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"lunch-tijdens-vliehors-expres\",\"slug\":\"lunch-tijdens-vliehors-expres\",\"name\":\"Lunch tijdens Vliehors Expres\",\"description\":\"En lunchtasje rijkelijk gevuld met : \\nBroodje Humus met geroosterde groenten \\nBroodje Brie met honing en walnoten \\nCandybar\\nVers fruit\\nBlikje Fuze Tea Green\\nFlesje water\",\"short_description\":\"Lunch tijdens een rit van de Vliehors Expres\",\"category\":\"catering\",\"block_type\":\"partner\",\"provider_id\":\"vliehors-expres\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":18.95,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/lunch-tijdens-vliehors-expres.png\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-06-29T13:21:49.8026+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":9,\"status\":\"published\",\"location_lat\":53.2679969,\"location_lng\":4.9687033,\"location_address\":\"Postweg 4, 8899 BZ Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"cafe-boven\",\"slug\":\"exclusieve-feestavond-in-cafe-boven\",\"name\":\"Exclusieve feestavond in Café Boven\",\"description\":\"Vier een besloten feestavond in Café Boven met volledige exclusiviteit. De ruimte is privé voor jullie groep en kan naar wens worden aangekleed. Mogelijkheden voor eigen versiering, gepersonaliseerde pubquiz, eigen muziekkeuze of DJ. Wij zorgen voor bar, personeel en sfeer — jullie bepalen het programma.\\n\\nDrankarrangementen, catering en extra techniek in overleg mogelijk.\",\"short_description\":\"Exclusieve feestavond in Café Boven, volledig naar eigen invulling.\",\"category\":\"locaties\",\"block_type\":\"partner\",\"provider_id\":\"cafe-boven\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":null,\"price_adult_note\":\"\",\"price_type\":\"on_request\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"Prijs op aanvraag\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770456335703-IMG_5841.jpeg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-07T09:26:04.985704+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2954393,\"location_lng\":5.0683344,\"location_address\":\"Dorpsstraat 83, Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"barbecue-aan-huis\",\"slug\":\"barbecue-aan-huis\",\"name\":\"Barbecue aan huis\",\"description\":\"Bij de compleet verzorgde barbecue komt vlees, salades, sausjes en brood. Ook vegetarische opties zijn uiteraard mogelijk. Servies (inclusief afwas) en schoonmaak van de barbecue.\\n\\nVleeskeuze (ruim assortiment per persoon):\\nSaté van de haas\\nSaté van de kip\\nSpeklap\\nBBQ-worst\\nRunderhamburger\\nBiefstuk\\nKarbonade (in kleinere hoeveelheid)\\nShaslick (in kleinere hoeveelheid)\\n\\nBijgerechten en brood:\\nZalmsalade\\nFruitsalade\\nKleine huzarensalade\\nStokbrood (verhouding iets meer wit dan bruin)\\nKruidenboter\\n\\nSauzen (inbegrepen):\\nSatésaus (warm)\\nKnoflooksaus (koud)\\nCocktailsaus (koud)\\nOverige afspraken\\n\\nU verzorgt zelf het bakken van het vlees (Grillmaster optioneel in te huren).\",\"short_description\":\"Compleet verzorgde barbecue\",\"category\":\"catering\",\"block_type\":\"partner\",\"provider_id\":\"zuiver\",\"min_people\":8,\"max_people\":null,\"duration\":\"\",\"price_adult\":32.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":20.00,\"price_child_note\":\"4-12 jaar\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/barbecue-aan-huis.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"barbecue\",\"bbq\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-08-06T13:35:41.026748+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2947964,\"location_lng\":5.0631051,\"location_address\":\"Dorpsstraat 182, 8899 AP Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"requir