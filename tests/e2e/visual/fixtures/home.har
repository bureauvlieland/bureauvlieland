rzorgd ontbijt bestellen bestaande uit: harde en zachte bollen, luxe zoete broodjes, croissants, sneetjes brood, zoet- en hartig beleg en vruchtensap.\",\"short_description\":\"We bezorgen een heerlijk ontbijt op elke locatie op Vlieland\",\"category\":\"catering\",\"block_type\":\"partner\",\"provider_id\":\"zuiver\",\"min_people\":8,\"max_people\":null,\"duration\":\"\",\"price_adult\":28.00,\"price_adult_note\":\"per persoon\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/ontbijt-op-locatie.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-03-21T14:28:53.473437+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":9,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":null,\"catering_type\":\"ontbijt\",\"catering_role\":\"hoofd\",\"required_with\":[],\"suggested_addons\":[\"bezorging-catering\"],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"paardrijden\",\"slug\":\"paardrijden\",\"name\":\"Paardrijden\",\"description\":\"Een droom voor iedere ruiter en een steeds terugkerend genoegen voor de gevorderde ruiter is het maken van een buitenrit door de duinen, het bos of langs het strand.   \",\"short_description\":\"Paardrijden op Vlieland bij Manege De Seeruyter\",\"category\":\"outdoor\",\"block_type\":\"partner\",\"provider_id\":\"manege-de-seeruyter\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":59.75,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/paardrijden.jpeg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-06T23:04:43.325302+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.3041518,\"location_lng\":5.0538396,\"location_address\":\"Badweg 8, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"doeksen-plate-nasi-kopie\",\"slug\":\"plateservice-aan-boord\",\"name\":\"Plateservice aan boord\",\"description\":\"U kunt als groep bij elkaar plaatsnemen en kiezen uit  Ambachtelijke hamburger, Nasi goreng, Pasta bolognese, Spareribs, Zoete aardappelcurry. Eet smakelijk. \\n\",\"short_description\":\"Eten aan boord op de terureis naar huis\",\"category\":\"catering\",\"block_type\":\"partner\",\"provider_id\":\"rederij\",\"min_people\":10,\"max_people\":null,\"duration\":\"\",\"price_adult\":14.95,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":true,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1780576141546-Low-FODMAP-nasi-goreng-9.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-06-04T12:23:23.388427+