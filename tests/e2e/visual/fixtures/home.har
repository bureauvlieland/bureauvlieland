,\"name\":\"Handboog Schieten\",\"description\":\"Ontdek de precisie en concentratie van handboogschieten onder begeleiding van ervaren instructeurs in de prachtige Vlielandse natuur.\\n\\nLet op: op de locatie zijn geen toiletvoorzieningen aanwezig.\",\"short_description\":\"Leer de kunst van het boogschieten in de duinen\",\"category\":\"outdoor\",\"block_type\":\"partner\",\"provider_id\":\"vlieland-outdoor-center\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":null,\"price_adult_note\":\"p.p.\",\"price_type\":\"on_request\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/voc-handboog-schieten.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":20,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-01-30T20:58:32.262712+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.303332,\"location_lng\":5.0453,\"location_address\":\"Strand t.h.v. bushalte Ankerplaats, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"regina-andrea-prive-terug\",\"slug\":\"privevaart-regina-andrea-vlieland-harlingen-incl-warm-buffet\",\"name\":\"Privévaart Regina Andrea — Vlieland → Harlingen (incl. warm buffet)\",\"description\":\"Exclusieve privévaart terug van Vlieland naar Harlingen aan boord van de Regina Andrea. Tijdens de overtocht staat een warm buffet voor u klaar — terwijl u nageniet van uw dag op het eiland, vaart u in alle rust terug. Menu wordt vooraf met u afgestemd, dieetwensen welkom.\