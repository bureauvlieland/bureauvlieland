            "mimeType": "application/json; charset=utf-8",
            "text": "[{\"id\":\"midgetgolf\",\"slug\":\"midgetgolf\",\"name\":\"Midgetgolf\",\"description\":\"Gelegen in het dorp is midgetgolfbaan De oude Vuurtoren een ideale plek om tegen elkaar te strijden voor het minst aantal slagen in 18 uitdagende holes. Voor jong en oud een leuke activiteit. \",\"short_description\":\"18 holes midgetgolfbaan\",\"category\":\"activiteiten\",\"block_type\":\"partner\",\"provider_id\":null,\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":8.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/midgetgolf.webp\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-05-15T13:36:45.876558+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.297222,\"location_lng\":5.076842,\"location_address\":\"Dennenlaan 2, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"fietstocht-met-begeleiding\",\"slug\":\"fietstocht-met-begeleiding\",\"name\":\"Fietstocht met begeleiding\",\"description\":\"Wij nemen u mee over het eiland in een twee uur durende fietstocht. De Vlielandse gids vertelt u van alles over het eiland, de natuur, de geschiedenis en de mensen. \",\"short_description\":\"Ontdek het eiland en haar verhalen op de fiets\",\"category\":\"excursies\",\"block_type\":\"bureau\",\"provider_id\":null,\"min_people\":10,\"max_people\":30,\"duration\":\"2 uur\",\"price_adult\":19.00,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/fietstocht-met-begeleiding.jpg\",\"image_asset\":\"fietstocht\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"fietsen\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-01-30T12:06:02.843899+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.296109,\"location_lng\":5.073688,\"location_address\":\"Waddendijk, Bij Willem De Vlamingh, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"bezoek-het-bunkermuseum\",\"slug\":\"bezoek-het-bunkermuseum\",\"name\":\"Bezoek het bunkermuseum\",\"description\":\"In de ontvangstbunker is een uitgebreide tentoonstelling over het leven en de gebeurtenissen op en rond Vlieland tijdens de Tweede Wereldoorlog en over het hoe en waarom van de fortificaties. Ook wordt een korte film vertoond over de oorlogsjaren op de eilanden en over de Atlantikwall.\\n\\nDaarna volgt een wandeling door de loopgraven en de bunkers, langs de uitzichtpunten en de geschutsopstellingen. In de elf bunkers zijn ook veel documenten, foto’s en voorwerpen tentoongesteld. In het buitenmuseum staan een paar grote objecten uit de oorlogsjaren, waaronder een middelzwaar luchtdoelkanon.\\n\\nBunkermuseum Wn 12H herinnert op een inzichtelijke en tastbare manier aan een periode uit de geschiedenis, die nooit mag worden vergeten.\",\"short_description\":\"Sinds voorjaar 2020 is Bunkermuseum Wn 12H voor bezoekers geopend. \",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"bunkermuseum\",\"min_people\":null,\"max_people\":null,\"duration\":\"1.5\",\"price_adult\":8.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":5.50,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/bezoek-het-bunkermuseum.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"geschiedenis\",\"museum\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-05-14T12:48:04.912581+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2991996,\"location_lng\":5.0399075,\"location_address\":\"Kantonnierspad 1, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"wadloopexcursie\",\"slug\":\"wadloopexcursie\",\"name\":\"Wadloopexcursie\",\"description\":\"\",\"short_description\":\"Begeleid wadlopen over de bodem van de Waddenzee\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"stichting-natuur-educatie-cent\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":17.50,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":12.50,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/wadloopexcursie.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-06T23:04:43.325302+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":121,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"cafe-boven\",\"slug\":\"exclusieve-feestavond-in-cafe-boven\",\"name\":\"Exclusieve feestavond in Café Boven\",\"description\":\"Vier een besloten feestavond in Café Boven met volledige exclusiviteit. De ruimte is privé voor jullie groep en kan naar wens worden aangekleed. Mogelijkheden voor eigen versiering, gepersonaliseerde pubquiz, eigen muziekkeuze of DJ. Wij zorgen voor bar, personeel en sfeer — jullie bepalen het programma.\\n\\nDrankarrangementen, catering en extra techniek in overleg mogelijk.\",\"short_description\":\"Exclusieve feestavond in Café Boven, volledig naar eigen invulling.\",\"category\":\"locaties\",\"block_type\":\"partner\",\"provider_id\":\"cafe-boven\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":null,\"price_adult_note\":\"\",\"price_type\":\"on_request\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"Prijs op aanvraag\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770456335703-IMG_5841.jpeg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-07T09:26:04.985704+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\