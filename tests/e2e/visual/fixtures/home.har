          "content": {
            "size": -1,
            "mimeType": "application/json; charset=utf-8",
            "text": "[{\"id\":\"eilandbeleving-compleet\",\"name\":\"Eilandbeleving Compleet\",\"short_description\":\"Drie volle dagen Vlieland: avontuur, cultuur en culinaire ontdekkingen voor groepen.\",\"duration_days\":3,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770301299090-DSC_3797_0012_DSC_3786.jpg\",\"indicative_price_pp\":null}, \n {\"id\":\"eilanddag-compleet\",\"name\":\"Eilanddag Compleet\",\"short_description\":\"Actief dagprogramma met lunch, activiteit en borrel\",\"duration_days\":1,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/zeehondentocht-exclusief.JPG\",\"indicative_price_pp\":null}, \n {\"id\":\"prive-eilanddag-regina-andrea\",\"name\":\"Exclusieve Eilanddag — Privévaart Regina Andrea\",\"short_description\":\"Uw eigen schip, eigen tempo: privévaart, fiets, strand en warm buffet aan boord.\",\"duration_days\":1,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/programmas/regina-andrea.jpg\",\"indicative_price_pp\":null}, \n {\"id\":\"relax-and-enjoy-vlieland\",\"name\":\"Ontspannen Eilandweekend\",\"short_description\":\"3 dagen comfort en genieten\",\"duration_days\":3,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770974443694-terras.2_1.jpg\",\"indicative_price_pp\":null}, \n {\"id\":\"avontuur-ontspanning\",\"name\":\"Avontuur & Ontspanning\",\"short_description\":\"Twee dagen actie en genieten\",\"duration_days\":2,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/voc-branding-raften.jpg\",\"indicative_price_pp\":null}, \n {\"id\":\"chill-eilanddag\",\"name\":\"Chill Eilanddag\",\"short_description\":\"Veel vrije tijd, lekker eten en het eiland zelf ontdekken.\",\"duration_days\":1,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770974443694-terras.2_1.jpg\",\"indicative_price_pp\":null}, \n {\"id\":\"actieve-eilanddag-voc\",\"name\":\"Actieve Eilanddag\",\"short_description\":\"Powerkiten, beach golf en lekker eten — sportief dagje uit.\",\"duration_days\":1,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/voc-beach-golf.jpg\",\"indicative_price_pp\":null}, \n {\"id\":\"culinaire-ontdekking\",\"name\":\"Culinaire Ontdekking Vlieland\",\"short_description\":\"Brouwerij, shared dining en outdoor BBQ — voor foodies.\",\"duration_days\":2,\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770455958249-Oliva_4.jpeg\",\"indicative_price_pp\":null}]"
