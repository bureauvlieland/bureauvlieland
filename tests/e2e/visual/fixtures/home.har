null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"vrije-tijd\",\"slug\":\"vrije-tijd\",\"name\":\"Vrije tijd\",\"description\":\"Ga op eigengelegenheid nog een rondje fietsen, bezoek de vuurtoren, het strand of de gezellige winkels en terassen in de Dorpsstraat\",\"short_description\":\"Vrije tijd op het eiland\",\"category\":\"overig\",\"block_type\":\"bureau\",\"provider_id\":null,\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":0.00,\"price_adult_note\":\"\",\"price_type\":\"total\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/1770974443694-terras.2_1.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-13T09:20:59.543228+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"exclusieve-rondleiding-en-proeverij-kaasbunker\",\"slug\":\"exclusieve-rondleiding-en-proeverij-kaasbunker\",\"name\":\"Exclusieve rondleiding en proeverij kaasbunker\",\"description\":\"Met deze tour krijgt u een exclusieve rondleiding van Kaasmaker Nils Koster.  Hij leidt u rond door de verschillende rijpingskamers van zijn kaasbunker. Hij verteld u op zijn eigen unieke manier  alles over het maken, rijpen, zeewier en schimmels. Uiteraard wordt de rondleiding afgesloten met een uitgebreide k