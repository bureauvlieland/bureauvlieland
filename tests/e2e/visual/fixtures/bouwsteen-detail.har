          "content": {
            "size": -1,
            "mimeType": "application/json",
            "text": "[{\"Id\":4,\"Name\":\"Robbentocht\",\"Description\":\"Uw bezoek aan Vlieland is niet compleet zonder een zeehondentocht met de Geus, de Northern Diver of de Vlielander. Met deze supersnelle rubberboten (40 mijl p/u) kunt u kennis maken met de natuur rondom Vlieland. Een ware belevenis voor jong en oud!\\r\\n\\r\\nDe schipper zal proberen om zo dicht mogelijk bij de robben te komen. U kunt de zeehonden zien genieten terwijl ze lekker liggen te zonnen op zandplaat De Richel of Engelschhoek bij Terschelling. Zeehonden zijn van nature nieuwsgierig en zwemmen vaak dicht bij de boot. \",\"Duration\":45,\"IsAvailableOnline\":true,\"Image\":\"e3f55fd7-2336-48ee-81ec-51787d3c4505\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":8,\"Name\":\"Robbentocht Schoolreis\",\"Description\":\"Special tarief voor schoolreisjes\",\"Duration\":30,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":11,\"Name\":\"Robbentocht schoolreis speciaal\",\"Description\":\"Variabel tarief voor schoolreisjes\",\"Duration\":30,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":13,\"Name\":\"Wildwater Varen\",\"Description\":\"Met 40 mijl per uur Over de Wadden & Noordzee\",\"Duration\":45,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":15,\"Name\":\"Water Taxi H-V\",\"Description\":\"Harlingen - Vlieland\",\"Duration\":45,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":16,\"Name\":\"Water Taxi V-T\",\"Description\":\"Vlieland - Terschelling\",\"Duration\":45,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":17,\"Name\":\"Water Taxi T-V\",\"Description\":\"Terschelling - Vlieland\",\"Duration\":45,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":18,\"Name\":\"Water Taxi V-H\",\"Description\":\"Vlieland - Harlingen\",\"Duration\":45,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":19,\"Name\":\"Tenderen\",\"Description\":\"Tenderen van en naar jachthaven Vlieland\",\"Duration\":45,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":44,\"Name\":\"Verhuur Speciaal\",\"Description\":\"Boot huur op afspraak\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":51,\"Name\":\"Water Taxi T-H\",\"Description\":\"\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":true,\"BookingTimeBuffer\":0},{\"Id\":52,\"Name\":\"Watertaxi H-T\",\"Description\":\"i\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":79,\"Name\":\"Watertaxi Tex - Har\",\"Description\":\"\",\"Duration\":0,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":81,\"Name\":\"Watertaxi Harl - Tex\",\"Description\":\"\",\"Duration\":0,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":277,\"Name\":\"Robbentocht vanaf Terschelling\",\"Description\":\"Robbentocht vanaf Terschelling. Wil je de zeehondjes eens van dichtbij bekijken? Maak dan met een speciale ribboot een tocht naar de zeehondenbank. Je ziet de zeehonden spelen met elkaar of lekker liggen zonnen op de zandbank. En omdat ze van nature nieuwsgierig zijn, komen ze vaak dichtbij de boot zwemmen. Het is dan ook voor iedereen, jong en oud, een onvergetelijke ervaring. Vergeet vooral je camera niet!\\r\\n\\r\\nLocatie :Haven, tegenover Willem Barentszkade 5 aan de steiger.Minimumleeftijd :5 jaar.Duur activiteit :60 minuten.\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":309,\"Name\":\"Watertaxi Kluut HV\",\"Description\":\"\",\"Duration\":50,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":310,\"Name\":\"Watertaxi Kluut VH\",\"Description\":\"\",\"Duration\":50,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":311,\"Name\":\"Watertaxi Kluut HT\",\"Description\":\"\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":312,\"Name\":\"Watertaxi T-H\",\"Description\":\"\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":313,\"Name\":\"Watertaxi Kluut VT\",\"Description\":\"\",\"Duration\":20,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":314,\"Name\":\"Watertaxi T-V\",\"Description\":\"\",\"Duration\":20,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0},{\"Id\":359,\"Name\":\"Water taxi T-H\",\"Description\":\"Terschelling - Harlingen\",\"Duration\":60,\"IsAvailableOnline\":false,\"Image\":\"\",\"OnlinePaymentsDisabled\":false,\"BookingTimeBuffer\":0}]"
