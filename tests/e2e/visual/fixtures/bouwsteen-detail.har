          "content": {
            "size": -1,
            "mimeType": "application/json; charset=utf-8",
            "text": "[{\"id\":\"wadloopexcursie\",\"slug\":\"wadloopexcursie\",\"name\":\"Wadloopexcursie\",\"description\":\"\",\"short_description\":\"Begeleid wadlopen over de bodem van de Waddenzee\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"stichting-natuur-educatie-cent\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":17.50,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":12.50,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/wadloopexcursie.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-06T23:04:43.325302+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":121,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"exclusieve-rondleiding-en-proeverij-kaasbunker\",\"slug\":\"exclusieve-rondleiding-en-proeverij-kaasbunker\",\"name\":\"Exclusieve rondleiding en proeverij kaasbunker\",\"description\":\"Met deze tour krijgt u een exclusieve rondleiding van Kaasmaker Nils Koster.  Hij leidt u rond door de verschillende rijpingskamers van zijn kaasbunker. Hij verteld u op zijn eigen unieke manier  alles over het maken, rijpen, zeewier en schimmels. Uiteraard wordt de rondleiding afgesloten met een uitgebreide kaasproeverij incl. thee, dips en ander lekkers\\n(met kinderen adviseren wij de videotour)\",\"short_description\":\"Met deze tour krijgt u een exclusieve rondleiding van Kaasmaker Nils Koster.\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"de-vlielander-kaasbunker\",\"min_people\":8,\"max_people\":null,\"duration\":\"\",\"price_adult\":null,\"price_adult_note\":\"\",\"price_type\":\"on_request\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"https://www.zeewierkaas.nl/\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/exclusieve-rondleiding-en-proeverij-kaasbunker.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-04-24T08:37:55.38382+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2955526,\"location_lng\":5.0565446,\"location_address\":\"Vlielander Kaasbunker, 5, Vuurboetsduin\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"bezoek-het-bunkermuseum\",\"slug\":\"bezoek-het-bunkermuseum\",\"name\":\"Bezoek het bunkermuseum\",\"description\":\"In de ontvangstbunker is een uitgebreide tentoonstelling over het leven en de gebeurtenissen op en rond Vlieland tijdens de Tweede Wereldoorlog en over het hoe en waarom van de fortificaties. Ook wordt een korte film vertoond over de oorlogsjaren op de eilanden en over de Atlantikwall.\\n\\nDaarna volgt een wandeling door de loopgraven en de bunkers, langs de uitzichtpunten en de geschutsopstellingen. In de elf bunkers zijn ook veel documenten, foto’s en voorwerpen tentoongesteld. In het buitenmuseum staan een paar grote objecten uit de oorlogsjaren, waaronder een middelzwaar luchtdoelkanon.\\n\\nBunkermuseum Wn 12H herinnert op een inzichtelijke en tastbare manier aan een periode uit de geschiedenis, die nooit mag worden vergeten.\",\"short_description\":\"Sinds voorjaar 2020 is Bunkermuseum Wn 12H voor bezoekers geopend. \",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"bunkermuseum\",\"min_people\":null,\"max_people\":null,\"duration\":\"1.5\",\"price_adult\":8.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":5.50,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/bezoek-het-bunkermuseum.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"geschiedenis\",\"museum\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-05-14T12:48:04.912581+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2991996,\"location_lng\":5.0399075,\"location_address\":\"Kantonnierspad 1, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"fietstocht-met-begeleiding\",\"slug\":\"fietstocht-met-begeleiding\",\"name\":\"Fietstocht met begeleiding\",\"description\":\"Wij nemen u mee over het eiland in een twee uur durende fietstocht. De Vlielandse gids vertelt u van alles over het eiland, de natuur, de geschiedenis en de mensen. \",\"short_description\":\"Ontdek het eiland en haar verhalen op de fiets\",\"category\":\"excursies\",\"block_type\":\"bureau\",\"provider_id\":null,\"min_people\":10,\"max_people\":30,\"duration\":\"2 uur\",\"price_adult\":19.00,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/fietstocht-met-begeleiding.jpg\",\"image_asset\":\"fietstocht\",\"is_published\":true,\"is_active\":true,\"sort_order\":0,\"tags\":[\"fietsen\"],\"seasonal_notes\":\"\",\"created_at\":\"2026-01-30T12:06:02.843899+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.296109,\"location_lng\":5.073688,\"location_address\":\"Waddendijk, Bij Willem De Vlamingh, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"vliehors-expres\",\"slug\":\"vliehors-expres\",\"name\":\"Vliehors Expres\",\"description\":\"Ontdek de 'Sahara van het Noorden' per vrachtwagen. De ongerepte westkant van het eiland.\",\"short_description\":\"Ontdek de Sahara van het Noorden\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"vliehors-expres\",\"min_people\":15,\"max_people\":50,\"duration\":\"2 uur\",\"price_adult\":30.00,\"price_adult_note\":\"\",\"price_type\":\"per_person\",\"price_child\":-0.01,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/vliehors-expres.JPG\",\"image_asset\":\"dunes-group.jpg\",\"is_published\":true,\"is_active\":true,\"sort_order\":3,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-01-25T14:17:18.06663+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.3042065,\"location_lng\":5.0499134,\"location_address\":\"Badweg 6, 8899 BV Vlieland\",\"map_activity_type_id\":382,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"vuurtoren\",\"slug\":\"vuurtorenbezoek\",\"name\":\"Vuurtorenbezoek\",\"description\":\"Beklim de vuurtoren voor een adembenemend uitzicht over het eiland en de Waddenzee.\",\"short_description\":\"Adembenemend uitzicht\",\"category\":\"excursies\",\"block_type\":\"bureau\",\"provider_id\":\"bureau\",\"min_people\":10,\"max_people\":25,\"duration\":\"1 uur\",\"price_adult\":8.00,\"price_adult_note\":\"p.p.\",\"price_type\":\"on_request\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"/assets/lighthouse-vlieland-Ba7e8Up3.jpg\",\"image_asset\":\"lighthouse-vlieland.jpg\",\"is_published\":true,\"is_active\":true,\"sort_order\":9,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-01-25T14:17:18.06663+00:00\",\"updated_at\":\"2026-06-17T06:54:20.959109+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.295767,\"location_lng\":5.058217,\"location_address\":\"Liesbeth Listpad, Oost-Vlieland\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"rondleiding-brouwerij-fortuna\",\"slug\":\"rondleiding-brouwerij-fortuna\",\"name\":\"Rondleiding Brouwerij Fortuna\",\"description\":\"Rondleiding door de lokale brouwerij met proeverij\",\"short_description\":\"\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"fortuna\",\"min_people\":null,\"max_people\":null,\"duration\":\"\",\"price_adult\":17.50,\"price_adult_note\":\"p.p.\",\"price_type\":\"per_person\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/rondleiding-brouwerij-fortuna.jpg\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":100,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-03T07:35:15.761661+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":21,\"status\":\"published\",\"location_lat\":53.2990258,\"location_lng\":5.0929034,\"location_address\":\"Fortuna Vlieland, 10, Fortweg\",\"map_activity_type_id\":278,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}, \n {\"id\":\"vliehors-expres-exclusief\",\"slug\":\"vliehors-expres-exclusief\",\"name\":\"Vliehors Expres Exclusief\",\"description\":\"De Vliehors Expres maakt een tocht met u over de Vliehors, een zandvlakte van 20 vierkante kilometer aan de westkant van Vlieland. De tocht duurt 2 uren. \\n\\nTijdens deze 2 uur durende rondritten laten wij u graag kennis maken met de weidsheid van de Vliehors. Natuurlijk stoppen we onderweg ook bij het drenkelingenhuisje. Al meer dan honderd jaar een vluchthuisje voor gestrande schipbreukelingen, nu ingericht als juttersmuseum.\\n\\nTijdens de rondrit stappen we ook uit op het meest westelijke puntje van Vlieland. We zijn dan vlak bij het buureiland Texel. Rond de punt van de Vliehors zwemmen vaak zeehonden. De kans is groot dat we deze dieren te zien krijgen. Een unieke ervaring in een fantastisch on Nederlands landschap.\",\"short_description\":\"Vliehors Expres, avontuurlijk Vlieland!\",\"category\":\"excursies\",\"block_type\":\"partner\",\"provider_id\":\"vliehors-expres\",\"min_people\":null,\"max_people\":null,\"duration\":\"2 uur\",\"price_adult\":825.00,\"price_adult_note\":\"\",\"price_type\":\"tiered_total\",\"price_child\":null,\"price_child_note\":\"\",\"price_child_min_age\":4,\"price_child_max_age\":12,\"price_pet\":null,\"price_pet_note\":\"\",\"is_from_price\":false,\"price_display_override\":\"\",\"price_extras\":{\"tiers\": [{\"price\": 750, \"max_people\": 29, \"min_people\": 0}, {\"price\": 850, \"max_people\": 39, \"min_people\": 30}, {\"price\": 950, \"max_people\": 49, \"min_people\": 40}, {\"price\": 1050, \"max_people\": 59, \"min_people\": 50}, {\"price\": 1150, \"max_people\": 69, \"min_people\": 60}, {\"price\": 1250, \"max_people\": 79, \"min_people\": 70}, {\"price\": 1350, \"max_people\": 89, \"min_people\": 80}, {\"price\": 1450, \"max_people\": 99, \"min_people\": 90}, {\"price\": 1550, \"max_people\": 109, \"min_people\": 100}, {\"price\": 1650, \"max_people\": 119, \"min_people\": 110}, {\"price\": 1750, \"max_people\": 129, \"min_people\": 120}, {\"price\": 1850, \"max_people\": 140, \"min_people\": 130}], \"tiers_above_max\": \"highest\"},\"external_url\":\"\",\"image_url\":\"https://utshmnyrjzwtrpttxdlw.supabase.co/storage/v1/object/public/building-block-images/vliehors-expres-exclusief.JPG\",\"image_asset\":\"\",\"is_published\":true,\"is_active\":true,\"sort_order\":101,\"tags\":[],\"seasonal_notes\":\"\",\"created_at\":\"2026-02-03T07:35:15.761661+00:00\",\"updated_at\":\"2026-09-17T14:48:45.438994+00:00\",\"price_includes_vat\":true,\"vat_rate\":9,\"status\":\"published\",\"location_lat\":null,\"location_lng\":null,\"location_address\":\"\",\"map_activity_type_id\":null,\"catering_type\":null,\"catering_role\":null,\"required_with\":[],\"suggested_addons\":[],\"scaling_rules\":[],\"provider\":null}]"
