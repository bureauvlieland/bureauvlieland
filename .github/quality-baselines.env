# Plafonds voor de kwaliteitspoorten in CI.
#
# Deze getallen mogen alleen OMLAAG. Een PR die er overheen gaat faalt. Zo
# hoeft de bestaande schuld niet eerst opgeruimd te worden voordat de poort
# dicht kan, maar groeit hij ook niet verder.
#
# Verlaag je een plafond, doe dat dan in dezelfde PR als de opruiming, zodat
# in de geschiedenis zichtbaar is waardoor het kon.

# eslint: fouten + waarschuwingen samen. Gemeten 2026-10-02 (klantportaal fase 3).
LINT_MAX=1159

# tsc -p tsconfig.strict.json. Gemeten 2026-10-02 (klantportaal fase 3).
STRICT_MAX=24

# scripts/check-design-debt.ts: losse paletkleuren, knop-overrides, radius en schaduw buiten het ontwerpsysteem. Gemeten 2026-10-01 (klantportaal fase 1, het klantportaal op de tokens).
DESIGN_DEBT_MAX=30
