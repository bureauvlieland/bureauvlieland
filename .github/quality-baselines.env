# Plafonds voor de kwaliteitspoorten in CI.
#
# Deze getallen mogen alleen OMLAAG. Een PR die er overheen gaat faalt. Zo
# hoeft de bestaande schuld niet eerst opgeruimd te worden voordat de poort
# dicht kan, maar groeit hij ook niet verder.
#
# Verlaag je een plafond, doe dat dan in dezelfde PR als de opruiming, zodat
# in de geschiedenis zichtbaar is waardoor het kon.

# eslint: fouten + waarschuwingen samen. Gemeten 2026-09-03.
LINT_MAX=1230

# tsc -p tsconfig.strict.json. Gemeten 2026-09-03.
STRICT_MAX=26
